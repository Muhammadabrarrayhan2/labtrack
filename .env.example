# Copy to .env for local development. Without DATABASE_URL the app uses SQLite (./labtrack.db).
APP_ENV=local
# DATABASE_URL=postgresql+psycopg://labtrack:labtrack@localhost:5432/labtrack
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
BOOTSTRAP_ADMIN_EMAIL=admin@labtrack.dev
BOOTSTRAP_ADMIN_PASSWORD=AdminPass123
# GCS_BUCKET=           # leave empty locally to store uploads in ./uploads
